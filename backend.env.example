# Copy to .env or set these variables in your deployment environment.
HLA_BACKEND_DATABASE_PATH=transplant.db
HLA_BACKEND_EXPORT_DIR=exports/audit
HLA_BACKEND_AUTO_MIGRATE=false
HLA_BACKEND_APP_NAME=HLA Transplantation Backend

# Optional. If set, every API request must include X-API-Key.
# HLA_BACKEND_API_KEY=replace-with-a-secret

# Optional comma-separated list for browser clients.
# HLA_BACKEND_CORS_ORIGINS=https://app.example.com,http://localhost:3000

HLA_BACKEND_HOST=127.0.0.1
HLA_BACKEND_PORT=8000
